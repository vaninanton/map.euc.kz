# Заголовки Cloudflare Pages. Заголовки всех совпавших правил объединяются;
# при конфликте одного и того же заголовка выигрывает более позднее правило.
# Vite копирует файл из public/ в dist/ как есть.

/*
    X-Content-Type-Options: nosniff
    Referrer-Policy: strict-origin-when-cross-origin
    X-Frame-Options: SAMEORIGIN

# Бандлы Vite: имя содержит хеш содержимого (index-BKaH0r_f.js), при изменении
# файла меняется и URL — кэшируем навсегда, без ревалидации.
/assets/*
    Cache-Control: public, max-age=31536000, immutable

# Иконки и splash-экраны PWA: имена НЕ хешируются (generate:pwa-icons перезаписывает
# те же файлы), поэтому неделя вместо immutable — иначе обновлённая иконка не доедет.
/icons/*
    Cache-Control: public, max-age=604800

/favicon.svg
    Cache-Control: public, max-age=604800

/favicon.ico
    Cache-Control: public, max-age=604800

/favicon-32x32.png
    Cache-Control: public, max-age=604800

/og-image.png
    Cache-Control: public, max-age=604800

# HTML — точка входа со ссылками на новые хеши ассетов. Всегда перепроверяем на
# сервере, иначе после деплоя пользователь тянет старый index.html и старые чанки.
/
    Cache-Control: public, max-age=0, must-revalidate

/index.html
    Cache-Control: public, max-age=0, must-revalidate

# Манифест лежит в app shell сервис-воркера (cache-first), но HTTP-кэш не должен
# мешать обновлению start_url и иконок.
/manifest.webmanifest
    Cache-Control: public, max-age=0, must-revalidate

# Сервис-воркер управляет инвалидацией всех остальных кэшей — сам залипнуть не должен.
/sw.js
    Cache-Control: no-cache
